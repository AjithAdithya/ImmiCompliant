# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/immicompliant

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Anthropic / Claude API (required for LangGraph agents)
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith (optional — for LLM tracing/observability)
LANGSMITH_API_KEY=ls__...
LANGSMITH_TRACING=false

# AWS S3 (for document storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=immicompliant-docs

# USCIS API
USCIS_API_KEY=

# CORS — set to your Vercel frontend URL (e.g. https://immicompliant.vercel.app)
FRONTEND_URL=
